# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model used for classification / generation. Check https://console.groq.com/docs/models
# for the current lineup if this id gets deprecated (Groq's model set changes often).
GROQ_MODEL=openai/gpt-oss-20b

# Determinism controls (see design note in README for rationale)
LLM_TEMPERATURE=0
LLM_SEED=42
